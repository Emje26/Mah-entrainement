<%= render 'shared/form_errors', object: item %>

<%= form_with model: item, class: 'form' do |f| %>
  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: 'form-control', required: true, autofocus: true %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, class: 'form-control', rows: 4 %>
  </div>

  <div class="form-row">
    <div class="form-group col-md-6">
      <%= f.label :price %>
      <%= f.number_field :price, class: 'form-control', step: 0.01, min: 0, required: true %>
    </div>

    <div class="form-group col-md-6">
      <%= f.label :quantity %>
      <%= f.number_field :quantity, class: 'form-control', min: 0, required: true %>
    </div>
  </div>

  <div class="form-group">
    <div class="form-check">
      <%= f.check_box :published, class: 'form-check-input' %>
      <%= f.label :published, class: 'form-check-label' %>
    </div>
  </div>

  <div class="form-group">
    <div class="form-check">
      <%= f.check_box :featured, class: 'form-check-input' %>
      <%= f.label :featured, class: 'form-check-label' %>
    </div>
  </div>

  <div class="form-group">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to t('common.cancel'), items_path, class: 'btn btn-outline' %>
  </div>
<% end %>
