<%= render 'shared/form_errors', object: user %>

<%= form_with model: user, class: 'form' do |f| %>
  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: 'form-control', required: true, autofocus: true %>
  </div>

  <div class="form-group">
    <%= f.label :email %>
    <%= f.email_field :email, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= f.label :password %>
    <%= f.password_field :password, class: 'form-control', required: user.new_record? %>
    <% unless user.new_record? %>
      <small class="form-text text-muted"><%= t('users.form.password_hint') %></small>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation, class: 'form-control', required: user.new_record? %>
  </div>

  <div class="form-group">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to t('common.cancel'), users_path, class: 'btn btn-outline' %>
  </div>
<% end %>
