<h1>Edit User</h1>

<% if user.errors.any? %>
  <div class="alert alert-danger">
    <ul>
      <% user.errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="/users/<%= user.id %>" method="post">
  <input type="hidden" name="_method" value="patch">

  <div class="form-group">
    <label for="name">Name</label>
    <input type="text" id="name" name="user[name]" value="<%= user.name %>" class="form-control" required>
  </div>

  <div class="form-group">
    <label for="email">Email</label>
    <input type="email" id="email" name="user[email]" value="<%= user.email %>" class="form-control" required>
  </div>

  <div class="form-group">
    <label for="password">Password (leave blank to keep current)</label>
    <input type="password" id="password" name="user[password]" class="form-control">
  </div>

  <button type="submit" class="btn btn-primary">Update User</button>
  <a href="/users/<%= user.id %>" class="btn btn-secondary">Cancel</a>
</form>
