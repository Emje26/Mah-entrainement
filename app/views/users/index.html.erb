<% content_for :title, t('users.index.title') %>

<div class="page-header">
  <h1><%= t('users.index.title') %></h1>
  <%= link_to t('users.index.new'), new_user_path, class: 'btn btn-primary' %>
</div>

<% if @users.any? %>
  <table class="table">
    <thead>
      <tr>
        <th><%= User.human_attribute_name(:name) %></th>
        <th><%= User.human_attribute_name(:email) %></th>
        <th><%= User.human_attribute_name(:created_at) %></th>
        <th><%= t('common.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= l(user.created_at, format: :short) %></td>
          <td>
            <%= link_to t('common.show'), user, class: 'btn btn-sm btn-outline' %>
            <%= link_to t('common.edit'), edit_user_path(user), class: 'btn btn-sm btn-outline' %>
            <%= button_to t('common.delete'), user, method: :delete,
                data: { turbo_confirm: t('common.confirm_delete') },
                class: 'btn btn-sm btn-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t('users.index.empty') %></p>
<% end %>
