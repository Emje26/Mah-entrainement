<% content_for :title, t('sessions.login') %>

<div class="auth-container">
  <h1><%= t('sessions.login') %></h1>

  <%= form_with url: login_path, method: :post, class: 'auth-form' do |f| %>
    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, class: 'form-control', required: true, autofocus: true %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password, class: 'form-control', required: true %>
    </div>

    <div class="form-group">
      <%= f.submit t('sessions.login_button'), class: 'btn btn-primary btn-block' %>
    </div>
  <% end %>

  <div class="auth-links">
    <p><%= t('sessions.no_account') %> <%= link_to t('sessions.signup_link'), new_user_path %></p>
  </div>
</div>
